{
  "name": "mailclient",
  "productName": "Chronell",
  "version": "1.0.3",
  "description": "Schlanker, lokaler Mail-Workflow-Client fuer Windows 11 mit Multi-Account-Support fuer Microsoft 365 und Gmail",
  "main": "out/main/index.js",
  "author": "Kurt Soeser",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:analyze": "cross-env ANALYZE_BUNDLE=1 electron-vite build",
    "prebuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-win-version.ps1",
    "build:win:inner": "npm run sync-branding && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win && node scripts/verify-win-branding.mjs",
    "finish:win": "node scripts/run-finish-win-build.mjs",
    "build:win": "npm run build:win:inner && npm run finish:win",
    "build:win:local": "cross-env CHRONELL_SKIP_PUBLISH=1 npm run build:win",
    "publish:docs-release:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-docs-release.ps1 -PushGit -NoOpen",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update-local.ps1",
    "release:local:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update-local.ps1 -RunInstaller",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "generate:calendar-icons": "node scripts/generate-calendar-icon-catalog.mjs",
    "sync-branding": "node scripts/sync-branding-assets.mjs",
    "publish:docs-release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-docs-release.ps1",
    "publish:day": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-day.ps1",
    "publish:day:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-day.ps1 -DryRun -NoPrompt",
    "release:notes": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-release-notes.ps1",
    "generate:homepage-screenshots": "node scripts/generate-homepage-screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:p0": "node scripts/verify-repo-coverage.mjs p0",
    "test:coverage:p1": "node scripts/verify-repo-coverage.mjs p1",
    "test:coverage:repos": "node scripts/verify-repo-coverage.mjs all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:i18n": "node scripts/validate-i18n-keys.mjs",
    "validate:version": "node scripts/validate-version-sync.mjs",
    "validate:knip": "knip",
    "docs:ipc-reference": "node scripts/generate-ipc-reference.mjs",
    "check": "npm run typecheck && npm run test && npm run lint && npm run validate:i18n && npm run validate:version",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "demo:build-pack": "node scripts/build-demo-pack.mjs && node scripts/build-demo-snapshot.mjs",
    "demo:build-snapshot": "node scripts/build-demo-snapshot.mjs",
    "demo:package-portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-demo-portable.ps1",
    "demo:launch": "cross-env CHRONELL_DEMO=1 npm run dev",
    "demo:reset": "node scripts/reset-demo-profile.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-serif": "^5.2.9",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/pt-sans": "^5.2.8",
    "@fontsource/raleway": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/luxon": "^6.1.20",
    "@fullcalendar/multimonth": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-virtual": "^3.13.26",
    "@tiptap/extension-color": "^3.23.2",
    "@tiptap/extension-highlight": "^3.23.2",
    "@tiptap/extension-image": "^3.23.2",
    "@tiptap/extension-link": "^3.23.2",
    "@tiptap/extension-placeholder": "^3.23.2",
    "@tiptap/extension-table": "^3.23.2",
    "@tiptap/extension-table-cell": "^3.23.2",
    "@tiptap/extension-table-header": "^3.23.2",
    "@tiptap/extension-table-row": "^3.23.2",
    "@tiptap/extension-task-item": "^3.23.2",
    "@tiptap/extension-task-list": "^3.23.2",
    "@tiptap/extension-text-align": "^3.23.2",
    "@tiptap/extension-text-style": "^3.23.2",
    "@tiptap/extension-underline": "^3.23.2",
    "@tiptap/pm": "^3.23.2",
    "@tiptap/react": "^3.23.2",
    "@tiptap/starter-kit": "^3.23.2",
    "@tiptap/suggestion": "^3.23.2",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.2",
    "electron-updater": "^6.8.3",
    "fix-webm-duration": "^1.0.6",
    "googleapis": "^144.0.0",
    "i18next": "^26.1.0",
    "isomorphic-fetch": "^3.0.0",
    "lucide-react": "^0.460.0",
    "luxon": "^1.28.1",
    "marked": "^18.0.5",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-virtuoso": "^4.18.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.20.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/luxon": "^1.27.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "knip": "^6.23.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rcedit": "^4.0.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "to-ico": "^1.1.5",
    "tsx": "^4.22.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true
  }
}
