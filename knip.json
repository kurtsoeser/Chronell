{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/main.tsx",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["**/*.test.ts", "**/*.d.ts", "out/**", "release/**"],
  "ignoreDependencies": [
    "@electron/rebuild",
    "electron",
    "electron-builder",
    "electron-vite",
    "postcss",
    "tailwindcss",
    "autoprefixer",
    "cross-env",
    "sharp",
    "to-ico",
    "rcedit",
    "rollup-plugin-visualizer",
    "jsdom"
  ]
}
